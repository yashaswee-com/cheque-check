# Template for `supabase secrets set --env-file`; these are Supabase Edge
# Function secrets, not Next.js/Vercel environment variables. Keep real values
# in an access-controlled local copy and never commit that copy.
# See docs/environment-and-secrets.md for destinations and security boundaries.

# Web Push (generate one VAPID key pair; public key also goes in the app build as
# NEXT_PUBLIC_VAPID_PUBLIC_KEY; private key must remain secret).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Web Push contact URI, e.g. mailto:ops@example.com or https://example.com/contact
VAPID_SUBJECT=

# Twilio Console -> account credentials and a voice-capable sender number.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Razorpay Dashboard -> Webhooks -> the configured webhook signing secret.
# This is distinct from RAZORPAY_KEY_SECRET.
RAZORPAY_WEBHOOK_SECRET=

# Operational safety switches: normally false/blank. Test mode redirects every
# outbound voice call to NOTIFICATIONS_TEST_PHONE; never enable for live delivery.
NOTIFICATIONS_FORCE_RUN=false
NOTIFICATIONS_TEST_MODE=false
NOTIFICATIONS_TEST_PHONE=

# Supabase injects SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY into Edge Functions;
# do not add them here. SMS OTP and Turnstile secrets belong to Supabase Auth
# config (SUPABASE_AUTH_SMS_TWILIO_AUTH_TOKEN / SUPABASE_AUTH_CAPTCHA_SECRET),
# not Edge Function secrets.