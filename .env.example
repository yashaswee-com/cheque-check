# Copy to the repository root as .env.local for local Next.js development.
# For hosted deployments, configure each environment in the hosting dashboard.
# Never commit real credentials. NEXT_PUBLIC_* values are public and bundled
# into the browser; keep all secret values out of those variables.
# Variable destinations and requirements: docs/environment-and-secrets.md

# -----------------------------------------------------------------------------
# 1. Supabase app connection (required)
# Local: `npx supabase status`; hosted: Supabase Dashboard -> Project Settings -> API.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-local-supabase-anon-key

# Environment identity (development | qa | production); deployment kind also
# allows preview. Use development/development locally, qa/preview for previews,
# and production/production for production. Deployed apps require hosted Supabase.
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_DEPLOYMENT_KIND=development
NEXT_PUBLIC_LOG_LEVEL=debug

# -----------------------------------------------------------------------------
# 2. Public feature configuration (safe for browser exposure)

# Phone OTP stays off until Supabase Auth SMS and CAPTCHA are configured.
NEXT_PUBLIC_PHONE_AUTH_ENABLED=false
# Cloudflare Dashboard -> Turnstile -> widget for this app's hostname (site key only).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Razorpay Dashboard -> Account & Settings -> API Keys (public Key ID).
# Use the matching server-side pair below; use Test Mode outside production.
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# Web Push: copy the public key from the VAPID pair generated for this app.
# The matching private key belongs only in Supabase Edge Function secrets.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Optional public support contact in E.164 format; defaults to the current app number.
NEXT_PUBLIC_WHATSAPP_SUPPORT_NUMBER=+919794457099

# -----------------------------------------------------------------------------
# 3. Server/build secrets (never expose or prefix with NEXT_PUBLIC_)

# OpenAI Platform -> API keys, in an environment-specific project; AI scans only.
OPENAI_API_KEY=

# Razorpay Dashboard -> API Keys. RAZORPAY_KEY_ID must match the public Key ID.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Supabase Dashboard -> Project Settings -> API -> service_role/secret key.
# Server/Ops only; never use the anon key here and never expose this to a browser.
SUPABASE_SERVICE_ROLE_KEY=

# Sentry -> project Settings -> source-map upload token; trusted builds only.
SENTRY_AUTH_TOKEN=

# -----------------------------------------------------------------------------
# 4. Optional monitoring / privacy controls (public build-time configuration)
# Defaults keep monitoring, replay, and Clarity off. Review
# docs/environment-and-secrets.md and docs/security-and-known-risks.md before enabling collection.
NEXT_PUBLIC_APP_RELEASE=
NEXT_PUBLIC_OBSERVABILITY_ENABLED=false
NEXT_PUBLIC_PREVIEW_MONITORING_ENABLED=false
NEXT_PUBLIC_MONITORING_POLICY_APPROVED=false
NEXT_PUBLIC_CLARITY_ENABLED=false
NEXT_PUBLIC_REPLAY_ENABLED=false
# Sampling rates are fractions from 0 to 1; defaults are 0.05, 0.01, and 0.25.
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.05
NEXT_PUBLIC_SENTRY_REPLAY_SAMPLE_RATE=0.01
NEXT_PUBLIC_SENTRY_ERROR_REPLAY_SAMPLE_RATE=0.25
# Sentry project -> Settings -> Client Keys (DSN); this DSN is public.
NEXT_PUBLIC_SENTRY_DSN=
# Microsoft Clarity -> project Settings / Setup. Leave blank when not configured.
NEXT_PUBLIC_CLARITY_PROJECT_ID=

# Marketing funnel analytics (off until the database migration and consent copy are deployed).
NEXT_PUBLIC_MARKETING_ANALYTICS_ENABLED=false
NEXT_PUBLIC_META_PIXEL_ID=1782530103005623
# Generate a random secret of at least 32 characters; server-only, never reuse a provider token.
MARKETING_COOKIE_SECRET=
# Set only to a header your hosting proxy overwrites with the real client IP.
# Leave blank until verified; otherwise IP matching is omitted.
MARKETING_TRUSTED_IP_HEADER=

# -----------------------------------------------------------------------------
# 5. Optional local Ops / QA automation only (secrets)

# Supabase Dashboard -> Connect / Database settings. Use a disposable QA DB only:
# `npm run test:e2e:qa` resets this database (migrations + seed) before testing.
SUPABASE_DB_URL=

# Optional Supabase personal access token for automated CLI login; interactive
# `supabase login` is preferred. Create/manage it in Supabase account settings.
SUPABASE_ACCESS_TOKEN=

# These are NOT environment variables: `project_url` and `service_role_key` are
# Supabase Vault entry names provisioned by configure_cron_credentials.
# Supabase Auth secrets are procured from Twilio Console (SMS auth token) and
# Cloudflare Turnstile (widget secret), then configured in Supabase Auth. They
# may be supplied securely to `supabase config push`, but do not belong in this
# app file or Vercel. Edge Function secrets and VAPID private keys are also
# configured in Supabase; see the setup guide for each destination.