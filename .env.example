# Core application configuration
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-supabase-anon-key
NEXT_PUBLIC_LOG_LEVEL=debug

# AI cheque scanning
OPENAI_API_KEY=

# Razorpay payments
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Administrative scripts and Supabase Edge Functions
SUPABASE_SERVICE_ROLE_KEY=

# QA e2e only (`npm run test:e2e:qa`, scripts/commands/dev/e2e-qa.ts): direct Postgres connection string used to
# fully reset (migrate + seed) the QA Supabase project before each e2e run.
# Get it from Project Settings -> Database -> Connection string (Session pooler
# recommended for IPv4 compatibility in CI).
SUPABASE_DB_URL=

# Sentry source map uploads
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# WhatsApp support contact link (defaults to +91 9794457099 if unset)
NEXT_PUBLIC_WHATSAPP_SUPPORT_NUMBER=+919794457099

# Microsoft Clarity analytics (per-environment project ID; leave blank to disable)
NEXT_PUBLIC_CLARITY_PROJECT_ID=


service_role_key=""
project_url=""

# Environment identity (production | qa | development) and deployment kind (production | qa | preview | local)
# Deployed environments must not point at a local Supabase URL.
NEXT_PUBLIC_APP_ENV=
NEXT_PUBLIC_DEPLOYMENT_KIND=

# Phone OTP login (see docs/phone-auth.md). Keep false until Twilio is configured in Supabase Auth.
# The SMS provider credentials live in Supabase Auth (SUPABASE_AUTH_SMS_TWILIO_AUTH_TOKEN for `supabase config push`), never here.
NEXT_PUBLIC_PHONE_AUTH_ENABLED=false
# Cloudflare Turnstile site key (public). The secret goes in Supabase Auth (SUPABASE_AUTH_CAPTCHA_SECRET).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=